# Local development defaults to a SQLite file in the backend directory.
DATABASE_URL=sqlite+pysqlite:///./aicte_nexus.db
# To use PostgreSQL instead, uncomment and set a local account/password:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/aicte_nexus
# Vercel: connect hosted PostgreSQL and set these in project Environment Variables.
# Standard postgres:// and postgresql:// URLs are also accepted.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# Optional direct connection used only by migrations (for example, supplied by Neon).
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

