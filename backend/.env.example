# Local development defaults to a SQLite file in the backend directory.
DATABASE_URL=sqlite+pysqlite:///./aicte_nexus.db
# To use PostgreSQL instead, uncomment and set a local account/password:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/aicte_nexus
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

